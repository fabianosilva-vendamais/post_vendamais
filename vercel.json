{
  "redirects": [{ "source": "/", "destination": "/studio/", "permanent": false }],
  "headers": [
    { "source": "/(.*)\\.(html|js)", "headers": [ { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" } ] },
    { "source": "/", "headers": [ { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" } ] }
  ]
}
